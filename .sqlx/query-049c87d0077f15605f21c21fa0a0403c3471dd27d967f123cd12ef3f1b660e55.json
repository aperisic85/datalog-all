  "db_name": "PostgreSQL",
  "query": "SELECT * FROM event_logs\n         WHERE object_id = $1\n           AND ($2::smallint IS NULL OR log_level >= $2)\n           AND ($3::timestamptz IS NULL OR recorded_at >= $3)\n           AND ($4::timestamptz IS NULL OR recorded_at <= $4)\n         ORDER BY recorded_at DESC LIMIT $5",
