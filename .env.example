# ── Database ─────────────────────────────────
DATABASE_URL=postgres://datalogger:datalogger@localhost:5432/datalogger

# ── Server ───────────────────────────────────
PORT=8095
RUST_LOG=datalogger_backend=debug,tower_http=info,sqlx=warn

# ── Auth ─────────────────────────────────────
# PROMIJENI ovo u produkciji! Minimalno 32 znaka.
JWT_SECRET=change-this-secret-in-production-minimum-32-chars

# ── Telegram bot (dvosmjerna komunikacija / upiti) ───────────────────────
# Token bota od @BotFather. Ako je postavljen, backend u pozadini sluša
# komande (/status, /alarmi, /objekt <ime>) i odgovara natrag u Telegram.
# Odgovara samo chat ID-evima registriranim kao omogućeni Telegram kanali.
# Ako nije postavljen, bot za upite je onemogućen (obavijesti i dalje rade).
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ── Pull mode (backend povlači podatke s dataloggera) ────────────────────
# Jedna stanica:
DATALOGGER_URL=http://drvenik.ddns.net:8010
DATALOGGER_NAME=Drvenik
DATALOGGER_USER=anonymous
DATALOGGER_PASS=
DATALOGGER_POLL_SEC=60

# Više stanica (JSON array, override za sve gornje):
# DATALOGGER_STATIONS=[
#   {"name":"Galija","url":"http://galija.ddns.net:8010","username":"anonymous","password":"","poll_interval_sec":60,
#    "tables":[
#      {"name":"Measurements_10min","initial_records":3},
#      {"name":"Alarms_10min","initial_records":3},
#      {"name":"Event_log","initial_records":10}
#    ]},
#   {"name":"Drvenik","url":"http://drvenik.ddns.net:8010","username":"anonymous","password":"","poll_interval_sec":60,
#    "tables":[
#      {"name":"Measurements_10min","initial_records":3},
#      {"name":"Alarms_10min","initial_records":3}
#    ]}
# ]
