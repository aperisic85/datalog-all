# ── Database ─────────────────────────────────
DATABASE_URL=postgres://datalogger:datalogger@localhost:5432/datalogger

# ── Server ───────────────────────────────────
PORT=8095
RUST_LOG=datalogger_backend=debug,tower_http=info,sqlx=warn

# ── Auth ─────────────────────────────────────
# PROMIJENI ovo u produkciji! Minimalno 32 znaka.
JWT_SECRET=change-this-secret-in-production-minimum-32-chars

# ── Telegram bot (dvosmjerna komunikacija / upiti) ───────────────────────
# Token bota od @BotFather. Ako je postavljen, backend u pozadini sluša
# komande (/status, /alarmi, /objekt <ime>) i odgovara natrag u Telegram.
# Odgovara samo chat ID-evima registriranim kao omogućeni Telegram kanali.
# Ako nije postavljen, bot za upite je onemogućen (obavijesti i dalje rade).
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ── AI tumačenje upita (natural language → komanda) ──────────────────────
# Ako je postavljen LLM_API_KEY, Telegram bot prima i upite običnim jezikom
# (npr. "koliki je napon baterije na objektu Barbarinac?") i sam ih mapira na
# odgovarajuću komandu. LLM SAMO prepoznaje namjeru i ime objekta — sve
# vrijednosti i dalje dolaze iz baze (nema izmišljanja podataka).
#
# Radi s bilo kojim OpenAI-kompatibilnim endpointom koji nudi besplatni tier.
# Preporuka: Groq (besplatan API ključ na https://console.groq.com, bez kartice).
#   LLM_API_KEY=gsk_...
#   LLM_API_URL=https://api.groq.com/openai/v1/chat/completions   # default
#   LLM_MODEL=llama-3.3-70b-versatile                             # default
#
# Alternativa (besplatni modeli) — OpenRouter:
#   LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Alternativa — Google Gemini (OpenAI-compat endpoint, besplatni tier):
#   LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=

# ── Energetska prognoza (predviđanje stanja baterije 7 dana unaprijed) ───
# Pozadinski scheduler periodički računa prognozu za sve aktivne objekte s
# koordinatama: prognozirana insolacija (Open-Meteo) × naučeni solarni omjer
# stanice − naučena dnevna potrošnja → predviđeni SOC i napon po danima.
# Rezultat se sprema u cache i koristi za karticu rizika na dashboardu te za
# jutarnji brifing. Ne treba API ključ — Open-Meteo je besplatan.
# ENERGY_FORECAST_ENABLED=true          # false isključuje scheduler
# ENERGY_FORECAST_INTERVAL_HOURS=6      # 1–24, default 6

# ── AI jutarnji brifing (dnevni sažetak na Telegram) ─────────────────────
# Svako jutro šalje pregled na sve omogućene Telegram kanale: novi alarmi u
# 24h, tihe stanice, energetski rizici i stanje po regijama. Brojke se uvijek
# računaju iz baze; LLM (ako je uključen) dodaje samo kratak uvodni komentar.
# Dostupno i na zahtjev komandom /brifing. Treba TELEGRAM_BOT_TOKEN.
# BRIEFING_ENABLED=true                 # false isključuje dnevno slanje
# BRIEFING_HOUR_UTC=5                   # 0–23; 5 UTC ≈ 07:00 ljetnog CET-a

# ── Pull mode (backend povlači podatke s dataloggera) ────────────────────
# Jedna stanica:
DATALOGGER_URL=http://drvenik.ddns.net:8010
DATALOGGER_NAME=Drvenik
DATALOGGER_USER=anonymous
DATALOGGER_PASS=
DATALOGGER_POLL_SEC=60

# Više stanica (JSON array, override za sve gornje):
# DATALOGGER_STATIONS=[
#   {"name":"Galija","url":"http://galija.ddns.net:8010","username":"anonymous","password":"","poll_interval_sec":60,
#    "tables":[
#      {"name":"Measurements_10min","initial_records":3},
#      {"name":"Alarms_10min","initial_records":3},
#      {"name":"Event_log","initial_records":10}
#    ]},
#   {"name":"Drvenik","url":"http://drvenik.ddns.net:8010","username":"anonymous","password":"","poll_interval_sec":60,
#    "tables":[
#      {"name":"Measurements_10min","initial_records":3},
#      {"name":"Alarms_10min","initial_records":3}
#    ]}
# ]
